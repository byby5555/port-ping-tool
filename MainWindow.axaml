<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:svc="clr-namespace:PortPingTool.Services"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="780"
        x:Class="PortPingTool.MainWindow"
        Title="Port &amp; Ping Tool"
        Width="1180" Height="780"
        MinWidth="900" MinHeight="720"
        Background="#F5F5F7"
        FontFamily="Inter, Segoe UI Variable, Segoe UI"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <SolidColorBrush x:Key="BgPanel">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="BgPanelAlt">#FAFAFC</SolidColorBrush>
    <SolidColorBrush x:Key="BorderColor">#E5E5EA</SolidColorBrush>
    <SolidColorBrush x:Key="DividerColor">#ECECEF</SolidColorBrush>
    <SolidColorBrush x:Key="TextPrimary">#1D1D1F</SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondary">#6E6E73</SolidColorBrush>
    <SolidColorBrush x:Key="TextTertiary">#8E8E93</SolidColorBrush>
    <SolidColorBrush x:Key="Accent">#007AFF</SolidColorBrush>
    <SolidColorBrush x:Key="AccentHover">#006FE6</SolidColorBrush>
    <SolidColorBrush x:Key="Success">#34C759</SolidColorBrush>
    <SolidColorBrush x:Key="Warning">#FF9500</SolidColorBrush>
    <SolidColorBrush x:Key="Danger">#FF3B30</SolidColorBrush>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    </Style>
    <Style Selector="TextBlock.cardTitle">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentHover}"/>
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="Background" Value="{StaticResource BgPanelAlt}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource Danger}"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource BgPanel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style Selector="Border.subcard">
      <Setter Property="Background" Value="{StaticResource BgPanelAlt}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
  </Window.Styles>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Top-right network info card (auto-detected public IP, geo, ISP) -->
    <Border Grid.Row="0" Classes="card" Margin="0,0,0,14" Padding="14,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <TextBlock Text="🌐" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="网络信息" FontWeight="SemiBold" FontSize="13"
                     Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" x:Name="NetInfoPanel" Margin="20,0,0,0"
                    VerticalAlignment="Center">
          <TextBlock x:Name="NetInfoOutside" FontSize="12" FontFamily="Cascadia Mono, Consolas"
                     Foreground="{StaticResource TextSecondary}">正在查询公网信息…</TextBlock>
          <TextBlock x:Name="NetInfoChina" FontSize="12" FontFamily="Cascadia Mono, Consolas"
                     Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0">国内侧查询中…</TextBlock>
          <TextBlock x:Name="NetInfoProxy" FontSize="12" FontFamily="Cascadia Mono, Consolas"
                     Foreground="{StaticResource TextTertiary}" Margin="0,2,0,0">代理状态: 未知</TextBlock>
        </StackPanel>
        <Button Grid.Column="2" x:Name="NetInfoRefreshBtn" Classes="secondary"
                Content="刷新" Click="OnNetInfoRefreshClick"/>
      </Grid>
    </Border>

    <!-- Main two-column body -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="380"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="*" MinWidth="380"/>
      </Grid.ColumnDefinitions>

    <!-- ====================== LEFT: PORT (Listen + Test) ====================== -->
    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,12">
        <TextBlock Text="端口" Classes="h1"/>
        <TextBlock Text="监听本机端口、测试远端端口连通性" Classes="h2" Margin="0,2,0,0"/>
      </StackPanel>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>

          <!-- Listener card -->
          <Border Classes="card">
            <StackPanel>
              <TextBlock Text="本机端口监听" Classes="cardTitle"/>
              <TextBlock Text="添加端口、启动监听,记录每个来访连接" Classes="caption" Margin="0,2,0,14"/>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PortInputBox" Grid.Column="0" Text="8080" />
                <Button Grid.Column="1" Classes="secondary" Margin="8,0,0,0"
                        Content="+ 添加" Click="OnAddListenerClick"/>
              </Grid>

              <ItemsControl x:Name="ListenerList" Margin="0,14,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="svc:PortListenerService">
                    <Border Classes="subcard" Margin="0,4" Padding="0,0">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="6"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Color stripe: green when listening, gray when stopped -->
                        <Border Grid.Column="0"
                                Background="{Binding StatusDotColor, Converter={x:Static svc:HexToBrushConverter.Instance}}"/>
                        <StackPanel Grid.Column="1" Margin="14,10,0,10" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PortDisplayText" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Tag="{Binding}"
                                       PointerPressed="OnPortLabelPointerPressed"
                                       ToolTip.Tip="点击修改端口号">
                              <Run Text="Port "/><Run Text="{Binding Port, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBox x:Name="PortEditBox" Width="80" FontSize="13" Padding="6,2"
                                     Text="{Binding Port, Mode=TwoWay}"
                                     KeyDown="OnPortEditKeyDown"
                                     LostFocus="OnPortEditLostFocus"
                                     IsVisible="False"/>
                          </StackPanel>
                          <TextBlock FontSize="11" Foreground="{StaticResource TextTertiary}">
                            <Run Text="连接 "/><Run Text="{Binding TotalConnections, Mode=OneWay}"/><Run Text=" 次"/>
                          </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,10,10,10" VerticalAlignment="Center">
                          <TextBlock FontSize="10" Foreground="{StaticResource TextTertiary}">状态</TextBlock>
                          <TextBlock FontSize="13" FontWeight="SemiBold"
                                     Foreground="{Binding StatusDotColor, Converter={x:Static svc:HexToBrushConverter.Instance}}">
                            <Run Text="{Binding StatusText}"/>
                          </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="3" Margin="14,0,6,0"
                                Tag="{Binding}" Click="OnToggleListenerClick"
                                Background="{Binding ToggleButtonColor, Converter={x:Static svc:HexToBrushConverter.Instance}}"
                                Content="{Binding ToggleButtonText}"/>
                        <Button Grid.Column="4" Margin="0,0,0,0"
                                Tag="{Binding}" Click="OnRemoveListenerClick"
                                Classes="secondary"
                                Content="删除"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="连接记录" Classes="label" Margin="0,16,0,6"/>
              <Border Classes="subcard" MinHeight="120" MaxHeight="200">
                <ScrollViewer x:Name="ConnectionLogScroller" VerticalScrollBarVisibility="Auto">
                  <ListBox x:Name="ConnectionLog" Padding="10,8"
                           Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="svc:ConnectionRecord">
                        <TextBlock Text="{Binding Display}"
                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,1"/>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </ScrollViewer>
              </Border>
            </StackPanel>
          </Border>

          <!-- Tester card -->
          <Border Classes="card" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Text="远端端口测试" Classes="cardTitle"/>
              <TextBlock Text="测试某个 IP 的端口是否开放" Classes="caption" Margin="0,2,0,14"/>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="主机 / IP" Classes="label"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="端口" Classes="label"/>
                <TextBox Grid.Row="1" Grid.Column="0" x:Name="TestHostBox" Text="1.1.1.1"/>
                <TextBox Grid.Row="1" Grid.Column="2" x:Name="TestPortBox" Text="443"/>
              </Grid>

              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button x:Name="TestPortClickBtn" Classes="primary"
                        Content="测试" Click="OnTestPortClick"/>
                <TextBlock x:Name="TestResultText" Margin="14,0,0,0"
                           VerticalAlignment="Center" FontSize="13"
                           Foreground="{StaticResource TextSecondary}"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Port scanner card: moved to the right column for layout balance -->
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ====================== RIGHT: PING + SCANNER (draggable splitter) ====================== -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="2*" MinHeight="280"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*" MinHeight="260"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,12">
        <TextBlock Text="Ping" Classes="h1"/>
        <TextBlock Text="高频 ICMP 探测,统计丢包与延迟" Classes="h2" Margin="0,2,0,0"/>
      </StackPanel>

      <Border Grid.Row="1" Classes="card">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Protocol mode: ICMP or TCP handshake -->
          <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="模式:" VerticalAlignment="Center" Margin="0,0,10,0"
                       Foreground="{StaticResource TextSecondary}" FontSize="12"/>
            <RadioButton x:Name="ModeIcmp" Content="ICMP" GroupName="Mode"
                         IsChecked="True"
                         VerticalAlignment="Center" Margin="0,0,14,0"
                         Checked="OnModeChanged"/>
            <RadioButton x:Name="ModeTcp" Content="TCP 握手 (1ms 可行)"
                         GroupName="Mode"
                         VerticalAlignment="Center"
                         Checked="OnModeChanged"/>
          </StackPanel>

          <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PingHostBox" Grid.Column="0" Text="1.1.1.1"/>
            <TextBox x:Name="PingPortBox" Grid.Column="1" Width="80" Margin="8,0,0,0"
                     Text="443"
                     ToolTip.Tip="仅 TCP 模式需要"
                     IsEnabled="False"/>
            <Button Grid.Column="2" x:Name="PingToggleBtn" Margin="8,0,0,0"
                    Classes="primary" Content="开始" Click="OnPingToggleClick"/>
          </Grid>

          <!-- Interval mode -->
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
            <TextBlock Text="间隔:" VerticalAlignment="Center" Margin="0,0,10,0"
                       Foreground="{StaticResource TextSecondary}" FontSize="12"/>
            <RadioButton x:Name="Interval1" Content="1 ms"
                         GroupName="Interval"
                         VerticalAlignment="Center" Margin="0,0,10,0"
                         Checked="OnIntervalChanged"/>
            <RadioButton x:Name="Interval10" Content="10 ms"
                         GroupName="Interval"
                         VerticalAlignment="Center" Margin="0,0,10,0"
                         Checked="OnIntervalChanged"/>
            <RadioButton x:Name="Interval100" Content="100 ms"
                         GroupName="Interval"
                         VerticalAlignment="Center" Margin="0,0,10,0"
                         Checked="OnIntervalChanged"/>
            <RadioButton x:Name="Interval1000" Content="1000 ms (标准)"
                         GroupName="Interval" IsChecked="True"
                         VerticalAlignment="Center"
                         Checked="OnIntervalChanged"/>
          </StackPanel>

          <!-- Interval hint: changes based on selected mode + interval -->
          <TextBlock x:Name="IntervalHint" Grid.Row="5"
                     FontSize="11" Margin="0,4,0,0"
                     Foreground="{StaticResource TextTertiary}"
                     Text="标准 ICMP,每 1 秒发一包,适用常规连通性测试。"/>

          <!-- Count mode -->
          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="次数:" VerticalAlignment="Center" Margin="0,0,10,0"
                       Foreground="{StaticResource TextSecondary}" FontSize="12"/>
            <RadioButton x:Name="CountContinuous" Content="持续"
                         GroupName="Count" IsChecked="True"
                         VerticalAlignment="Center" Margin="0,0,14,0"/>
            <RadioButton x:Name="CountFixed" Content="自定义:"
                         GroupName="Count"
                         VerticalAlignment="Center"/>
            <TextBox x:Name="CountBox" Width="60" Margin="6,0,0,0" Text="10" IsEnabled="False"/>
          </StackPanel>

          <!-- Statistics panel — explicitly small font + Auto-width columns so the
               big number can't push the column wider on hi-DPI screens. -->
          <Border Grid.Row="6" Classes="subcard" Margin="0,14,0,0" Padding="14,10">
            <StackPanel Orientation="Horizontal" Spacing="20">
              <StackPanel>
                <TextBlock Text="已发送" Classes="caption"/>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <TextBlock x:Name="StatSent" Text="0" FontSize="16" FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimary}"/>
                  <TextBlock x:Name="StatSentUnit" Text="" FontSize="10"
                             Foreground="{StaticResource TextTertiary}"
                             VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </StackPanel>
              </StackPanel>

              <StackPanel>
                <TextBlock Text="已接收" Classes="caption"/>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <TextBlock x:Name="StatRecv" Text="0" FontSize="16" FontWeight="SemiBold"
                             Foreground="{StaticResource Success}"/>
                  <TextBlock x:Name="StatRecvUnit" Text="" FontSize="10"
                             Foreground="{StaticResource TextTertiary}"
                             VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </StackPanel>
              </StackPanel>

              <StackPanel>
                <TextBlock Text="丢包率" Classes="caption"/>
                <TextBlock x:Name="StatLoss" Text="0.0%" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource Danger}"/>
              </StackPanel>

              <StackPanel>
                <TextBlock Text="平均延迟" Classes="caption"/>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <TextBlock x:Name="StatAvg" Text="0" FontSize="16" FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimary}"/>
                  <TextBlock x:Name="StatAvgUnit" Text="ms" FontSize="10"
                             Foreground="{StaticResource TextTertiary}"
                             VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <Grid Grid.Row="7" Margin="0,14,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock Text="结果" Classes="label" Margin="0,0,14,0" VerticalAlignment="Center"/>
              <RadioButton x:Name="ShowAllRadio" Content="全部" GroupName="PingView"
                           IsChecked="True" Margin="0,0,14,0"
                           Checked="OnPingViewChanged"/>
              <RadioButton x:Name="ShowLostRadio" Content="只丢包" GroupName="PingView"
                           Checked="OnPingViewChanged"/>
              <TextBlock x:Name="PingListCount" Margin="14,0,0,0"
                         VerticalAlignment="Center" FontSize="11"
                         Foreground="{StaticResource TextTertiary}"/>
            </StackPanel>
            <Border Grid.Row="1" Classes="subcard">
              <ScrollViewer x:Name="PingResultScroller" VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="PingResults" Padding="10,8"
                         Background="Transparent" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="svc:PingRecord">
                      <TextBlock Text="{Binding Display}"
                                 FontFamily="Cascadia Mono, Consolas, Courier New"
                                 FontSize="11" Margin="0,1"
                                 Foreground="{Binding RowColor, Converter={x:Static svc:HexToBrushConverter.Instance}}"/>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </ScrollViewer>
            </Border>
          </Grid>
        </Grid>
      </Border>

      <!-- Draggable splitter between Ping and Scanner cards -->
      <GridSplitter Grid.Row="2"
                    Height="6"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    ResizeDirection="Rows"
                    ShowsPreview="True"
                    Margin="0,4,0,4"/>

      <!-- Port scanner card (moved to right column for layout balance) -->
      <Border Grid.Row="3" Classes="card" Margin="0,4,0,0">
        <StackPanel>
          <TextBlock Text="端口扫描" Classes="cardTitle"/>
          <TextBlock Text="本机: 瞬时列出 LISTEN 端口。远端: TCP 握手探测。"
                     Classes="caption" Margin="0,2,0,14"/>

          <!-- Target row -->
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="目标:" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{StaticResource TextSecondary}" FontSize="12"/>
            <TextBox x:Name="ScanTargetBox" Width="200" Text="127.0.0.1"
                     ToolTip.Tip="本机: 127.0.0.1 / 0.0.0.0 / localhost。远端: 任意 IP 或域名"/>
          </StackPanel>

          <!-- Ports row -->
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="端口:" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{StaticResource TextSecondary}" FontSize="12"/>
            <TextBox x:Name="ScanPortsBox" Width="200" Text="80,443,8000-8100"
                     ToolTip.Tip="支持: 80 / 80,443 / 1-100 / 80,443,8000-8100 / all"/>
          </StackPanel>

          <!-- Concurrency slider -->
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="并发:" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{StaticResource TextSecondary}" FontSize="12"/>
            <Slider Grid.Column="1" x:Name="ScanConcurrencySlider"
                    Minimum="10" Maximum="100" Value="50"
                    TickFrequency="10" IsSnapToTickEnabled="True"/>
            <TextBlock Grid.Column="2" x:Name="ScanConcurrencyText"
                       Text="50" Margin="8,0,0,0" VerticalAlignment="Center"
                       FontSize="12" Width="30"
                       Foreground="{StaticResource TextSecondary}"/>
          </Grid>

          <!-- Action row -->
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="ScanBtn" Classes="primary" Content="扫描"
                    Click="OnScanClick"/>
            <Button x:Name="ScanCancelBtn" Classes="secondary" Margin="8,0,0,0"
                    Content="取消" Click="OnScanCancelClick" IsEnabled="False"/>
            <TextBlock x:Name="ScanStatusText" Margin="14,0,0,0"
                       VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource TextTertiary}"/>
          </StackPanel>

          <!-- Progress -->
          <ProgressBar x:Name="ScanProgressBar" Margin="0,10,0,0"
                       Minimum="0" Maximum="1" Value="0" Height="6"/>

          <!-- Results -->
          <Border Classes="subcard" Margin="0,12,0,0" Padding="0">
            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
              <ListBox x:Name="ScanResults" Padding="0,4"
                       Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="svc:LocalPortRow">
                    <Grid Margin="10,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="50"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding DisplayPort}"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="12" FontWeight="SemiBold"
                                 Foreground="{StaticResource Accent}"/>
                      <TextBlock Grid.Column="1" Text="{Binding DisplayAddress}"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="11" Margin="10,0,0,0"
                                 Foreground="{StaticResource TextSecondary}"/>
                      <TextBlock Grid.Column="2" Text="{Binding DisplayState}"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="11"
                                 Foreground="{StaticResource Success}"/>
                      <TextBlock Grid.Column="3" Text="{Binding DisplaySource}"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="11"
                                 Foreground="{StaticResource TextTertiary}"/>
                      <TextBlock Grid.Column="4" Text="{Binding DisplayPid}"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="11" Margin="0,0,10,0"
                                 HorizontalAlignment="Right"
                                 Foreground="{StaticResource TextTertiary}"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </ScrollViewer>
          </Border>
        </StackPanel>
      </Border>
    </Grid>
    </Grid>

    <!-- Status bar (bottom): shows the last status/log message -->
    <Border Grid.Row="2" Classes="subcard" Padding="10,6" Margin="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="ℹ " FontSize="11"
                   Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" x:Name="StatusBarText"
                   FontFamily="Cascadia Mono, Consolas" FontSize="11"
                   Foreground="{StaticResource TextSecondary}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Text="就绪"/>
        <Button Grid.Column="2" x:Name="ShowLogBtn" Classes="secondary"
                Content="日志" Click="OnShowLogClick" Padding="10,4" FontSize="11"/>
      </Grid>
    </Border>

    <!-- Log popup (toggle via status-bar button) -->
    <Border x:Name="LogPopup" Grid.Row="0" Grid.RowSpan="3"
            IsVisible="False" Background="#CC000000" Padding="0">
      <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
              Margin="0,0,0,80" Width="700" MaxHeight="300"
              Background="{StaticResource BgPanel}"
              BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
              CornerRadius="12" Padding="0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="14,10,14,8">
            <TextBlock Text="事件日志" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"/>
            <Button Classes="secondary" HorizontalAlignment="Right"
                    Content="关闭" Click="OnCloseLogClick" Padding="8,3" FontSize="11"/>
          </Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ListBox x:Name="LogItems" Padding="14,0,14,10"
                     Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="x:String">
                  <TextBlock Text="{Binding}"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="11"
                             Foreground="{StaticResource TextSecondary}"
                             Margin="0,1"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>
  </Grid>
</Window>
