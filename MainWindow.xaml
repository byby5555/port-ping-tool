<Window x:Class="PortPingTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Port &amp; Ping Tool"
        Width="1180" Height="780"
        MinWidth="900" MinHeight="600"
        Background="{x:Static local:AppleTheme.BgWindowBrush}"
        FontFamily="Segoe UI Variable, Segoe UI"
        WindowStartupLocation="CenterScreen"
        xmlns:local="clr-namespace:PortPingTool">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="HeadingText">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{x:Static local:AppleTheme.TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SubHeadingText">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{x:Static local:AppleTheme.TextSecondaryBrush}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="CaptionText">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{x:Static local:AppleTheme.TextTertiaryBrush}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="LabelText">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{x:Static local:AppleTheme.TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="TextBox" x:Key="AppleTextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{x:Static local:AppleTheme.BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{x:Static local:AppleTheme.BgPanelBrush}"/>
            <Setter Property="Foreground" Value="{x:Static local:AppleTheme.TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{x:Static local:AppleTheme.AccentBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{x:Static local:AppleTheme.AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{x:Static local:AppleTheme.AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{x:Static local:AppleTheme.BgPanelAltBrush}"/>
            <Setter Property="Foreground" Value="{x:Static local:AppleTheme.TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{x:Static local:AppleTheme.BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{x:Static local:AppleTheme.DividerBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{x:Static local:AppleTheme.DangerBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*" MinWidth="380"/>
        </Grid.ColumnDefinitions>

        <!-- ====================== LEFT: PORT (Listen + Test) ====================== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="端口" Style="{StaticResource HeadingText}"/>
                <TextBlock Text="监听本机端口、测试远端端口连通性"
                           Style="{StaticResource SubHeadingText}" Margin="0,2,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Listener card -->
                    <Border Style="{x:Static local:AppleTheme.CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="本机端口监听" Style="{StaticResource HeadingText}" FontSize="15"/>
                            <TextBlock Text="添加端口、启动监听,记录每个来访连接"
                                       Style="{StaticResource CaptionText}" Margin="0,2,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PortInputBox" Grid.Column="0"
                                         Style="{StaticResource AppleTextBox}"
                                         Text="8080" />
                                <Button Grid.Column="1" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="+ 添加" Click="OnAddListenerClick"/>
                            </Grid>

                            <ItemsControl x:Name="ListenerList" Margin="0,14,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,4" CornerRadius="10"
                                                Background="{x:Static local:AppleTheme.BgPanelAltBrush}"
                                                Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="10" Height="10"
                                                         VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{x:Static local:AppleTheme.TextTertiaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                                    <Setter Property="Fill" Value="{x:Static local:AppleTheme.SuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{x:Static local:AppleTheme.TextPrimaryBrush}">
                                                        <Run Text="Port "/><Run Text="{Binding Port, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="11"
                                                               Foreground="{x:Static local:AppleTheme.TextTertiaryBrush}">
                                                        <Run Text="连接 "/><Run Text="{Binding TotalConnections, Mode=OneWay}"/><Run Text=" 次"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="2" Margin="0,0,6,0"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Tag="{Binding}" Click="OnToggleListenerClick">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                            <Setter Property="Content" Value="启动"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                                    <Setter Property="Content" Value="停止"/>
                                                                    <Setter Property="Background" Value="{x:Static local:AppleTheme.DangerBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="连接记录 (最新在上)" Style="{StaticResource LabelText}" Margin="0,16,0,6"/>
                            <Border Background="{x:Static local:AppleTheme.BgPanelAltBrush}"
                                    BorderBrush="{x:Static local:AppleTheme.BorderBrush}"
                                    BorderThickness="1" CornerRadius="8"
                                    MinHeight="120" MaxHeight="200">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ConnectionLog" Padding="10,8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Display}"
                                                           FontFamily="Cascadia Mono, Consolas, Courier New"
                                                           FontSize="11"
                                                           Foreground="{x:Static local:AppleTheme.TextSecondaryBrush}"
                                                           Margin="0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Tester card -->
                    <Border Style="{x:Static local:AppleTheme.CardBorderStyle}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="远端端口测试" Style="{StaticResource HeadingText}" FontSize="15"/>
                            <TextBlock Text="测试某个 IP 的端口是否开放"
                                       Style="{StaticResource CaptionText}" Margin="0,2,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="主机 / IP" Style="{StaticResource LabelText}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="端口" Style="{StaticResource LabelText}"/>
                                <TextBox Grid.Row="1" Grid.Column="0" x:Name="TestHostBox"
                                         Style="{StaticResource AppleTextBox}" Text="1.1.1.1"/>
                                <TextBox Grid.Row="1" Grid.Column="2" x:Name="TestPortBox"
                                         Style="{StaticResource AppleTextBox}" Text="443"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="测试"
                                        Click="OnTestPortClick"/>
                                <TextBlock x:Name="TestResultText" Margin="14,0,0,0"
                                           VerticalAlignment="Center" FontSize="13"
                                           Foreground="{x:Static local:AppleTheme.TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ====================== RIGHT: PING ====================== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Ping" Style="{StaticResource HeadingText}"/>
                <TextBlock Text="高频 ICMP 探测,统计丢包与延迟"
                           Style="{StaticResource SubHeadingText}" Margin="0,2,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{x:Static local:AppleTheme.CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PingHostBox" Grid.Column="0"
                                 Style="{StaticResource AppleTextBox}" Text="1.1.1.1"/>
                        <Button Grid.Column="1" Margin="8,0,0,0" x:Name="PingToggleBtn"
                                Style="{StaticResource PrimaryButton}" Content="开始"
                                Click="OnPingToggleClick"/>
                    </Grid>

                    <!-- Interval mode -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Text="间隔:" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{x:Static local:AppleTheme.TextSecondaryBrush}"
                                   FontSize="12"/>
                        <RadioButton x:Name="Interval1000" Content="1000 ms (标准)"
                                     GroupName="Interval" IsChecked="True"
                                     VerticalAlignment="Center" Margin="0,0,14,0"
                                     Checked="OnIntervalChanged"/>
                        <RadioButton x:Name="Interval100" Content="100 ms (快)"
                                     GroupName="Interval"
                                     VerticalAlignment="Center"
                                     Checked="OnIntervalChanged"/>
                    </StackPanel>

                    <!-- Count mode -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="次数:" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{x:Static local:AppleTheme.TextSecondaryBrush}"
                                   FontSize="12"/>
                        <RadioButton x:Name="CountContinuous" Content="持续"
                                     GroupName="Count" IsChecked="True"
                                     VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <RadioButton x:Name="CountFixed" Content="自定义:"
                                     GroupName="Count"
                                     VerticalAlignment="Center"/>
                        <TextBox x:Name="CountBox" Width="60" Margin="6,0,0,0"
                                 Style="{StaticResource AppleTextBox}" Text="10"
                                 IsEnabled="False"/>
                    </StackPanel>

                    <!-- Statistics panel -->
                    <Border Grid.Row="3" Margin="0,14,0,0"
                            Background="{x:Static local:AppleTheme.BgPanelAltBrush}"
                            CornerRadius="8" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="已发送" Style="{StaticResource CaptionText}"/>
                                <TextBlock x:Name="StatSent" Text="0" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{x:Static local:AppleTheme.TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="已接收" Style="{StaticResource CaptionText}"/>
                                <TextBlock x:Name="StatRecv" Text="0" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{x:Static local:AppleTheme.SuccessBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="丢包率" Style="{StaticResource CaptionText}"/>
                                <TextBlock x:Name="StatLoss" Text="0.0%" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{x:Static local:AppleTheme.DangerBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="平均延迟" Style="{StaticResource CaptionText}"/>
                                <TextBlock x:Name="StatAvg" Text="0 ms" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{x:Static local:AppleTheme.TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="4" Text="实时结果" Style="{StaticResource LabelText}" Margin="0,14,0,6"/>
                    <Border Grid.Row="4" Margin="0,32,0,0"
                            Background="{x:Static local:AppleTheme.BgPanelAltBrush}"
                            BorderBrush="{x:Static local:AppleTheme.BorderBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <ScrollViewer x:Name="PingResultScroller" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PingResults" Padding="10,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}"
                                                   FontFamily="Cascadia Mono, Consolas, Courier New"
                                                   FontSize="11" Margin="0,1">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{x:Static local:AppleTheme.TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Success}" Value="False">
                                                            <Setter Property="Foreground" Value="{x:Static local:AppleTheme.DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
